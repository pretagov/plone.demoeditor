<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <include package="plone.rest" file="meta.zcml" />

  <!-- Signing in as the demo without a password (login.py): a login option
       (GET @login) and the sign-in itself. Both answer only where the demo
       is on. -->
  <adapter
      factory=".login.DemoLoginProvider"
      name="plone.demoeditor"
      />

  <plone:service
      method="POST"
      name="@login-demo"
      for="plone.base.interfaces.siteroot.IPloneSiteRoot"
      factory=".login.DemoLogin"
      permission="zope2.Public"
      />

  <genericsetup:registerProfile
      name="default"
      title="Demo editor"
      description="A public demo account that can edit, and keeps nothing (DEMO_EDITOR_PASSWORD, DEMO_EDITOR_PATHS)"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Demo editor (uninstall)"
      description="Removes the demo account"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      post_handler=".setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="plone.demoeditor-hiddenprofiles"
      />

  <!-- Keyed on the demo user, not on the layer: should the account ever
       outlive the add-on, its saves must still be thrown away. -->
  <subscriber
      for="ZPublisher.interfaces.IPubAfterTraversal"
      handler=".demo.doom_demo_requests"
      />

  <subscriber
      for="zope.processlifetime.IDatabaseOpenedWithRoot"
      handler=".demo.make_demo_editor_at_startup"
      />

  <!-- The root admin's password, from DEMO_ADMIN_PASSWORD. Not per site: the
       admin lives in the Zope root, outside every site. -->
  <subscriber
      for="zope.processlifetime.IDatabaseOpenedWithRoot"
      handler=".demo.set_admin_password_at_startup"
      />

</configure>
